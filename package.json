{
  "name": "pareek-store",
  "version": "1.0.0",
  "description": "Pareek Store — Full-stack MERN e-commerce platform by Ankit Pareek",
  "main": "backend/index.js",
  "type": "module",
  "scripts": {
    "backend": "nodemon backend/index.js",
    "frontend": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run frontend\" \"npm run backend\"",
    "build": "npm run build --prefix frontend",
    "vercel-build": "cd frontend && npm install && npm run build"
  },
  "keywords": [
    "mern",
    "ecommerce",
    "react",
    "express",
    "mongodb",
    "nodejs"
  ],
  "author": "Ankit Pareek <2024kuec2077@iiitkota.ac.in>",
  "license": "ISC",
  "engines": {
    "node": "22.x"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankitpareek4955/e-commerce.git"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "concurrently": "^8.2.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-handler": "^1.2.0",
    "express-formidable": "^1.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.6.3",
    "multer": "^1.4.5-lts.1",
    "nodemon": "^3.0.1"
  }
}
